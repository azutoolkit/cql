#!/usr/bin/env python3
"""Fail before release mutations if the version violates the stable-release plan."""
import re
import sys
from pathlib import Path


def parse(value):
    if not re.fullmatch(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", value):
        raise ValueError(f"invalid stable release version: {value!r}")
    return tuple(map(int, value.split(".")))


def main():
    if len(sys.argv) != 2:
        raise ValueError("usage: script/check-release-version VERSION")
    match = re.search(r"^version:\s*(\S+)\s*$", Path("shard.yml").read_text(), re.MULTILINE)
    if not match:
        raise ValueError("shard.yml must declare its current version")
    current, target = parse(match[1]), parse(sys.argv[1])
    if current[0] == 0 and target != (1, 0, 0):
        raise ValueError("the first stable release must be exactly 1.0.0; check merge strategy and semantic-version inputs")
    if target <= current:
        raise ValueError("release version must be greater than the version in shard.yml")
    print(f"Release version accepted: {sys.argv[1]}")


if __name__ == "__main__":
    try:
        main()
    except ValueError as error:
        sys.exit(str(error))
